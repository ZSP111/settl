# Copy to .env.local and adjust. All values are public (they ship to the browser).
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_SETTL_CONTRACT_ID=settl-billonaire.testnet
NEXT_PUBLIC_USDC_CONTRACT_ID=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
NEXT_PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io

# Optional, server-only (never NEXT_PUBLIC): NEAR Intents 1-Click API key from partners.near-intents.org.
# Without it, 1-Click charges a 0.2% fee.
ONECLICK_JWT=
